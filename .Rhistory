seq(
min((test_pos$Date), na.rm=T),
max((test_pos$Date), na.rm=T),
365/4) |> round()
)
test_pos |> ggplot(aes(x = as.Date(Date, format = "%d/%m/%Y"), y = cumPos)) + geom_line() + scale_x_continuous(breaks = breaks, breaks_minor = breaks_minor)
