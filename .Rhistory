test_pos <- read_delim("~/Desktop/Test_pos_over_time.csv",
delim = ";", escape_double = FALSE, trim_ws = TRUE) |>
as.data.frame() |>
filter(!Date %in% c("I alt", "Antal personer")) |>
mutate(Date = as.Date(Date, format = "%d/%m/%Y"), cumPos = cumPos/6e6)
library(ggplot2)
breaks <- as.Date(
seq(
min((test_pos$Date), na.rm=T),
max((test_pos$Date), na.rm=T),
365/2) |> round()
)
breaks_minor <- as.Date(
seq(
min((test_pos$Date), na.rm=T),
max((test_pos$Date), na.rm=T),
365/4) |> round()
)
test_pos |> ggplot(aes(x = Date, y = cumPos)) + geom_line() + scale_x_continuous(breaks = breaks, minor_breaks = breaks_minor)
test_pos |> ggplot(aes(x = Date, y = cumPos)) + geom_line() + scale_x_continuous(breaks = breaks, minor_breaks = breaks_minor) + scale_y_continuous(ylim = c(0,0.65))
