df <- tibble::tibble(
date = as.Date(runif(df_n, min = 0, max = 730)),
y = as.numeric(date) * 0.2 + rnorm(df_n, 0, 100)
)
with(df, plot(date, y, pch="."))
df |> ggplot(aes(x = date, y = y)) +
geom_point(alpha = 0.2, size = .6) +
geom_smooth(method = "lm", formula = y~x, se = T)
