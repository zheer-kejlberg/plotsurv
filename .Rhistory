tte.table <- tibble(
group = group,
time2 = pmin(t1, t2, censortime),
eventtype = ifelse(t1 < t2 & t1 < censortime, 1,
ifelse(t2 < t1 & t2 < censortime, 2, 0))
)
#tte.table <- tte.table[tte.table$eventtype != 2,]
fit <- survfit(Surv(time2, factor(eventtype)) ~ group, data=tte.table)
plotsurv(fit,
risk.table = T,
strata_labels = c("Treatment group", "Control group"),
table.breakpoints = 7,
ticks = T,
ticksize = 3,
tickalpha = 0.5,
include_surv=T,
conf.int = F,
group_labels = c("Treated, 1", "Treated, 2", "Untreated, 1", "Untreated, 2"))
